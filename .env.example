# Optional. The normal path is `tsx src/sign-in.ts`, which opens Chrome so you
# can sign in by hand -- two-factor included -- and leaves a browser profile
# every later run reuses. These only help an unattended run on a fresh profile,
# and only when Amazon does not challenge the login.
AMAZON_EMAIL=
AMAZON_PASSWORD=

ASIN=

OPENAI_API_KEY=
